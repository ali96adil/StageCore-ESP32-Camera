# StageCore ESP32 Camera — C3 camera-service candidate.
CONFIG_STAGECORE_CAMERA_C3=y

# The physically-qualified AI Thinker board has ~4 MiB PSRAM. Keep the native
# esp32-camera driver on the same 80 MHz PSRAM shape recommended by Espressif.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SUPPORT=y
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# C3 must preserve the physically observed legacy Arduino app0/OTA/NVS map.
# This is intentionally different from the generic C1/C2 single-app layout.
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_camera_legacy.csv"
